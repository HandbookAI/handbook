# Applies the repo's formatting to every editor, including for the file types
# Prettier has no parser for (.sh, .py fixtures) and for anyone editing before
# the pre-commit hook runs.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
# Markdown uses two trailing spaces as a hard line break.
trim_trailing_whitespace = false

[LICENSE]
insert_final_newline = false

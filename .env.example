# Copy to .env (git-ignored) — the `handbook` CLI auto-loads ./.env from the
# directory you run it in. Shell environment variables always win over this file.
#
# Generated by `pnpm run config:docs` from the settings registry — do not hand-edit;
# a hand-edit fails packages/cli/src/docs-drift.test.ts, which names this command as
# the fix. See docs/configuration.md for the full reference.

# ── analyze, generate, render, skill, validate, plan, apply, rollback, resync, studio, config ──
# log verbosity; -v/--verbose and -q/--quiet are shorthand for debug/error
#HANDBOOK_LOG_LEVEL=info

# ── generate, plan, resync, studio ──
# API key for the LLM endpoint; use EMPTY for keyless local endpoints. Never a flag and never allowed in the config file
# secret — must never appear in a config file; set it here or in the shell only
OPENAI_API_KEY=sk-...
#HANDBOOK_LLM_API_KEY=sk-...
# model identifier
#HANDBOOK_LLM_MODEL=gpt-4o-mini
#OPENAI_MODEL=gpt-4o-mini
# any OpenAI-compatible endpoint (hosted, vLLM, LiteLLM, a proxy)
#HANDBOOK_LLM_BASE_URL=https://api.openai.com/v1
#OPENAI_BASE_URL=https://api.openai.com/v1
# max output tokens per request
#HANDBOOK_LLM_MAX_TOKENS=16000
#OPENAI_MAX_TOKENS=16000
# per-request deadline in seconds; a stalled call is retried rather than allowed to hold a phase hostage
#HANDBOOK_LLM_TIMEOUT=300
#OPENAI_TIMEOUT=300
# retry attempts per request; 0 means a single attempt
#HANDBOOK_LLM_MAX_RETRIES=6
# base backoff between retries, in seconds
#HANDBOOK_LLM_RETRY_BACKOFF=3
# global cap on concurrent requests through one client
#HANDBOOK_LLM_CONCURRENCY=16
# vendor fields merged into every request body; model/messages/token fields cannot be overridden
#HANDBOOK_LLM_EXTRA_BODY={"thinking":{"type":"disabled"}}
#OPENAI_EXTRA_BODY={"thinking":{"type":"disabled"}}

# ── analyze, generate, plan, apply, validate, skill, rollback ──
# source root; required for analyze/generate/plan/apply, optional elsewhere (hash freshness for validate/skill, and the tree a backup belongs to for rollback)
#HANDBOOK_SOURCE=./src

# ── analyze, generate, render, resync, skill ──
# work directory holding pipeline artifacts; optional for skill, where it adds coverage.json
#HANDBOOK_WORK=./.handbook

# ── analyze, generate ──
# source language; auto detects and merges every registered language
#HANDBOOK_LANG=auto

# ── render, resync ──
# handbook title for rendered outputs
#HANDBOOK_TITLE=System Handbook

# ── generate ──
# all | 1 | 2 | 2a | 2b | 2c | 3, or a comma list
#HANDBOOK_PHASE=all
# file (default) or member; unset keeps the work dir's recorded strategy
# HANDBOOK_STRATEGY (no default — see the comment above)
# user-authored skeleton.yaml, required for the member strategy
# HANDBOOK_SKELETON (no default — see the comment above)
# prose language
#HANDBOOK_NARRATE_LANG=en
# card depth
#HANDBOOK_DETAIL=brief
# skeleton synthesis mode
#HANDBOOK_SYNTH_MODE=oneshot
# doctor convergence rounds
#HANDBOOK_MAX_DOCTOR_ROUNDS=6
# concurrent card batches
#HANDBOOK_READ_WORKERS=12
# files per card batch; unset means 1 for --detail deep and 8 for brief
# HANDBOOK_READ_BATCH_SIZE (no default — see the comment above)
# truncate each file at n chars; 0 means no limit
#HANDBOOK_MAX_CHARS_PER_FILE=0
# cards per assignment batch
#HANDBOOK_ASSIGN_BATCH_SIZE=25
# concurrent assignment batches
#HANDBOOK_ASSIGN_WORKERS=12
# concurrent stage-organize calls
#HANDBOOK_ORGANIZE_WORKERS=8
# concurrent narration calls
#HANDBOOK_NARRATE_WORKERS=8
# skip files that already have a completed card
#HANDBOOK_RESUME=false
# ignore phase-3 caches
#HANDBOOK_REFRESH=false
# cache raw LLM replies under <work>/phase3/cache; disabled by --refresh
#HANDBOOK_LLM_CACHE=false

# ── render, skill, plan ──
# output location; render defaults to <work>/handbook, plan writes a file, skill writes a directory
# HANDBOOK_RENDER_OUT (no default — see the comment above)
# HANDBOOK_SKILL_OUT (no default — see the comment above)
# HANDBOOK_PLAN_OUT (no default — see the comment above)

# ── render ──
# also render the multi-page HTML site under <out>/html
#HANDBOOK_HTML=false
# also render a single self-contained HTML page
#HANDBOOK_HTML_SINGLE=false
# also render the agent locator index under <out>/agent
#HANDBOOK_AGENT_SITE=false
# also write llms.txt and llms-full.txt next to the markdown
#HANDBOOK_LLMS_TXT=false
# link file cards to the source at <url>/<relative path>
# HANDBOOK_SOURCE_BASE_URL (no default — see the comment above)

# ── skill, plan ──
# rendered handbook directory; required for skill, optional context for plan
# HANDBOOK_SKILL_HANDBOOK (no default — see the comment above)
# HANDBOOK_PLAN_HANDBOOK (no default — see the comment above)

# ── skill ──
# skill slug (lowercase-hyphen)
# HANDBOOK_NAME (no default — see the comment above)
# human project name for prose
# HANDBOOK_PROJECT (no default — see the comment above)
# rendered agent locator site; ships under references/agent/
# HANDBOOK_AGENT_DIR (no default — see the comment above)
# SKILL.md body language; frontmatter stays English for routing
#HANDBOOK_SKILL_BODY_LANG=en

# ── validate ──
# skill directory to validate
# HANDBOOK_SKILL (no default — see the comment above)

# ── plan ──
# the natural-language change request
# HANDBOOK_REQUEST (no default — see the comment above)
# agent turn budget
#HANDBOOK_MAX_TURNS=30

# ── apply ──
# plan file produced by `handbook plan`
# HANDBOOK_PLAN (no default — see the comment above)
# verify only, never write
#HANDBOOK_DRY_RUN=false
# where backups go; defaults to <source>/.handbook-patches
# HANDBOOK_BACKUP_ROOT (no default — see the comment above)

# ── rollback ──
# backup directory containing manifest.json
# HANDBOOK_BACKUP (no default — see the comment above)
# restore even files that changed after the patch
#HANDBOOK_FORCE=false

# ── resync ──
# case directory: edited/ + plan.md + change.diff
# HANDBOOK_CASE (no default — see the comment above)
# set false for a structural refresh only, with prose marked stale
#HANDBOOK_USE_LLM=true
# set false to skip refreshing already-rendered outputs under <work>/handbook
#HANDBOOK_REFRESH_RENDERED=true
# agent-reported corrections.jsonl; its files widen the refresh set
# HANDBOOK_CORRECTIONS (no default — see the comment above)
# card depth for regenerated cards; unset matches the existing handbook
# HANDBOOK_RESYNC_CARD_DETAIL (no default — see the comment above)
# prose language for regenerated cards; unset matches the existing handbook
# HANDBOOK_RESYNC_PROSE_LANG (no default — see the comment above)

# ── studio ──
# port to listen on; binds 127.0.0.1 only
#HANDBOOK_PORT=4860
# where studio.json and managed work dirs live; defaults to $HOME/.handbook-studio
# HANDBOOK_STATE_DIR (no default — see the comment above)

# ── config ──
# show only the settings that apply to this subcommand; its env/file/default layers are inspectable here, but that command's own flags are not (pass them to the command itself)
# HANDBOOK_FOR_COMMAND (no default — see the comment above)
# machine-readable output
#HANDBOOK_JSON=false
# validate only; exit non-zero if anything is invalid or missing
#HANDBOOK_CHECK=false

# Copy to .env (git-ignored) — the `handbook` CLI auto-loads ./.env from the
# directory you run it in. Shell environment variables always win over this file.

# Required for LLM phases (generate/plan/resync). Use EMPTY for keyless local endpoints.
OPENAI_API_KEY=sk-...

# Optional — any OpenAI-compatible endpoint works (vLLM, LiteLLM, a proxy, …).
#OPENAI_MODEL=gpt-4o-mini
#OPENAI_BASE_URL=https://api.openai.com/v1
#OPENAI_MAX_TOKENS=16000

# Optional handbook knobs.
#HANDBOOK_TITLE=My Project Handbook
#HANDBOOK_LLM_MAX_RETRIES=6
#HANDBOOK_LLM_RETRY_BACKOFF=3

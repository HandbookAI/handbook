{
  "name": "@handbook/renderer",
  "version": "0.1.0",
  "description": "Render a handbook model to markdown pages, an agent locator index, and a self-contained HTML site",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run"
  },
  "dependencies": {
    "@handbook/core": "workspace:*",
    "markdown-it": "catalog:"
  },
  "devDependencies": {
    "@types/markdown-it": "catalog:"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.11"
  }
}

{
  "name": "@handbook/patcher",
  "version": "0.1.0",
  "description": "Apply a plan's EDIT blocks to a source tree byte-exactly, with dry-run, verification and rollback",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run"
  },
  "dependencies": {
    "@handbook/core": "workspace:*"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.11"
  }
}

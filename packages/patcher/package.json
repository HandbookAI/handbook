{
  "name": "@handbooks/patcher",
  "version": "1.1.0",
  "description": "Apply a plan's EDIT blocks to a source tree byte-exactly, with dry-run, verification and rollback",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run"
  },
  "dependencies": {
    "@handbooks/core": "workspace:*"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.11"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HandbookAI/handbook.git",
    "directory": "packages/patcher"
  },
  "homepage": "https://github.com/HandbookAI/handbook/tree/main/packages/patcher#readme",
  "bugs": {
    "url": "https://github.com/HandbookAI/handbook/issues"
  }
}

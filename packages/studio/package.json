{
  "name": "@handbook/studio",
  "version": "0.1.0",
  "description": "Local web UI over the handbook toolchain: browse handbooks, run generation, plan changes, and roll handbooks forward",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "public",
    "!dist/**/*.map"
  ],
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run"
  },
  "dependencies": {
    "@handbook/analyzer": "workspace:*",
    "@handbook/core": "workspace:*",
    "@handbook/llm": "workspace:*",
    "@handbook/patcher": "workspace:*",
    "@handbook/pipeline": "workspace:*",
    "@handbook/planner": "workspace:*",
    "@handbook/renderer": "workspace:*",
    "@handbook/resync": "workspace:*",
    "@handbook/skill": "workspace:*",
    "zod": "catalog:"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.11"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HandbookAI/handbook.git",
    "directory": "packages/studio"
  },
  "homepage": "https://github.com/HandbookAI/handbook/tree/main/packages/studio#readme",
  "bugs": {
    "url": "https://github.com/HandbookAI/handbook/issues"
  }
}

{
  "name": "@handbook/analyzer",
  "version": "0.1.0",
  "description": "Multi-language static call-graph extraction via tree-sitter (WASM) — no LLM",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run"
  },
  "dependencies": {
    "@handbook/core": "workspace:*",
    "tree-sitter-wasms": "catalog:",
    "web-tree-sitter": "catalog:"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.11"
  }
}

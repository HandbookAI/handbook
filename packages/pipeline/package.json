{
  "name": "@handbooks/pipeline",
  "version": "1.2.0",
  "description": "Handbooks generation pipeline: static graph -> cards -> skeleton -> assignment -> narration",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run"
  },
  "dependencies": {
    "@handbooks/analyzer": "workspace:*",
    "@handbooks/core": "workspace:*",
    "@handbooks/llm": "workspace:*",
    "yaml": "catalog:",
    "zod": "catalog:"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.11"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HandbookAI/handbooks.git",
    "directory": "packages/pipeline"
  },
  "homepage": "https://github.com/HandbookAI/handbooks/tree/main/packages/pipeline#readme",
  "bugs": {
    "url": "https://github.com/HandbookAI/handbooks/issues"
  }
}

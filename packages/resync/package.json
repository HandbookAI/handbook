{
  "name": "@handbooks/resync",
  "version": "1.2.0",
  "description": "Roll a handbook's derived layer forward after code changes (diff-driven incremental update)",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run"
  },
  "dependencies": {
    "@handbooks/analyzer": "workspace:*",
    "@handbooks/core": "workspace:*",
    "@handbooks/llm": "workspace:*",
    "@handbooks/pipeline": "workspace:*",
    "zod": "catalog:"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.11"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HandbookAI/handbook.git",
    "directory": "packages/resync"
  },
  "homepage": "https://github.com/HandbookAI/handbook/tree/main/packages/resync#readme",
  "bugs": {
    "url": "https://github.com/HandbookAI/handbook/issues"
  }
}

{
  "name": "@handbooks/cli",
  "version": "1.2.0",
  "description": "The handbook command-line interface",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run"
  },
  "bin": {
    "handbook": "./dist/main.js"
  },
  "dependencies": {
    "@handbooks/analyzer": "workspace:*",
    "@handbooks/core": "workspace:*",
    "@handbooks/llm": "workspace:*",
    "@handbooks/patcher": "workspace:*",
    "@handbooks/pipeline": "workspace:*",
    "@handbooks/planner": "workspace:*",
    "@handbooks/renderer": "workspace:*",
    "@handbooks/resync": "workspace:*",
    "@handbooks/skill": "workspace:*",
    "@handbooks/studio": "workspace:*",
    "commander": "catalog:"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.11"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HandbookAI/handbook.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/HandbookAI/handbook/tree/main/packages/cli#readme",
  "bugs": {
    "url": "https://github.com/HandbookAI/handbook/issues"
  }
}
